{
  "name": "moments",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm install --no-audit && vite build",
    "start": "node index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node index.js",
    "dev:client": "vite"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "ytsr": "^3.8.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}