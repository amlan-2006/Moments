    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "^19.0.0-beta-df7b53d-20241126",
    "framer-motion": "^11.11.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
